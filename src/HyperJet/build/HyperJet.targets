    <Using Include="HyperJet.DDScalar6&lt;System.Double&gt;" Alias="DDScalar6" />
    <Using Include="HyperJet.DDScalar7&lt;System.Double&gt;" Alias="DDScalar7" />
    <Using Include="HyperJet.DDScalar8&lt;System.Double&gt;" Alias="DDScalar8" />
    <Using Include="HyperJet.DDScalar9&lt;System.Double&gt;" Alias="DDScalar9" />
    <Using Include="HyperJet.DDScalar10&lt;System.Double&gt;" Alias="DDScalar10" />
